# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/shelflife
# Or MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/shelflife

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Perplexity API
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# OpenAI (Fallback if needed, or if Perplexity is accessed via OpenAI client)
OPENAI_API_KEY=optional_fallback_openai_key

# Redis (optional for Bull queue in production)
REDIS_URL=redis://localhost:6379

# Cloudinary (optional — for screenshot storage if base64 is too large)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App
MAX_LINKS_PER_SHELF=200
DECAY_CHECK_CRON=0 * * * *
SCRAPE_TIMEOUT_MS=15000
AI_TIMEOUT_MS=10000
